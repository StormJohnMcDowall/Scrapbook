<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scrapbook.Core\Scrapbook.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ThemeMode (Fluent theme) is marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <AssemblyName>Scrapbook</AssemblyName>
    <!-- Exe icon; WPF windows without their own Icon use it for the title bar, taskbar and Alt+Tab.
         Regenerate with tools/make-icon.ps1. -->
    <ApplicationIcon>Scrapbook.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release output: one framework-dependent Scrapbook.exe (uses the installed .NET 10 runtime). -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

</Project>
