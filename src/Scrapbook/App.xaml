<Application x:Class="Scrapbook.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Scrapbook"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <!-- ThemeMode="System": light/dark follows Windows and switches live when it changes.
         For any custom colours, use Fluent theme brushes via DynamicResource (e.g.
         DividerStrokeColorDefaultBrush), not SystemColors, which stay light in dark mode. -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:InverseBoolConverter x:Key="InverseBool" />
    </Application.Resources>
</Application>
