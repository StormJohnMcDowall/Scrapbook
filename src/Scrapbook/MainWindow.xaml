<Window x:Class="Scrapbook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:core="clr-namespace:Scrapbook.Core;assembly=Scrapbook.Core"
        xmlns:vm="clr-namespace:Scrapbook.Core.ViewModels;assembly=Scrapbook.Core"
        xmlns:b="clr-namespace:Scrapbook.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="Scrapbook"
        Width="420" Height="560" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}">
    <DockPanel>
        <!-- Top bar -->
        <Border DockPanel.Dock="Top" Padding="12,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel LastChildFill="False">
                <ToggleButton DockPanel.Dock="Right" Content="Edit" MinWidth="64"
                              IsChecked="{Binding IsEditing}" />
                <StackPanel DockPanel.Dock="Left" Orientation="Vertical">
                    <CheckBox Content="Always on top" IsChecked="{Binding AlwaysOnTop}" />
                    <CheckBox Content="Hide from screen share" IsChecked="{Binding HideFromScreenShare}"
                              IsEnabled="{Binding IsEditing}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom bar (Edit mode only) -->
        <Border DockPanel.Dock="Bottom" Padding="12,10"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
            <Button Content="+ Add item" HorizontalAlignment="Left" Command="{Binding AddItemCommand}" />
        </Border>

        <!-- List -->
        <Grid>
            <TextBlock Text="{x:Static core:Messages.EmptyList}" Margin="16" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ItemsList" ItemsSource="{Binding Items}" Margin="0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ItemViewModel}">
                            <Border x:Name="Row" Padding="12,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Description: plain text when locked, a box in Edit mode -->
                                    <TextBlock Grid.ColumnSpan="4" Text="{Binding Description}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                                               Visibility="{Binding IsEditable, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <TextBox x:Name="DescriptionBox" Grid.ColumnSpan="4" Margin="0,0,0,4"
                                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Body: text box, or password box when masked -->
                                    <Grid Grid.Row="1" Grid.Column="0" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                                 TextWrapping="NoWrap" AcceptsReturn="False"
                                                 IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBool}}"
                                                 Visibility="{Binding IsMasked, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <PasswordBox b:PasswordBoxAssist.BoundPassword="{Binding Body}"
                                                     Focusable="{Binding IsEditable}"
                                                     IsHitTestVisible="{Binding IsEditable}"
                                                     Visibility="{Binding IsMasked, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>

                                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Mask" Margin="8,0,0,0" MinWidth="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsMasked}" IsEnabled="{Binding IsEditable}" />

                                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding CopyCommand}"
                                            MinWidth="88" Margin="4,0,0,0" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content" Value="Copy" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCopied}" Value="True">
                                                        <Setter Property="Content" Value="Copied ✓" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button Grid.Row="1" Grid.Column="3" Content="×" ToolTip="Delete"
                                            Margin="4,0,0,0" VerticalAlignment="Center"
                                            Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsEditable, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
